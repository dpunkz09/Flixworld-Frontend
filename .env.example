# ── Backend API ───────────────────────────────────────────────────────────────
# IMPORTANT: NEXT_PUBLIC_API_BASE is embedded in the browser bundle at build time.
# It must be the PUBLIC URL that browsers can reach — never localhost in production.
#
# Option A: Backend on a separate subdomain (recommended)
#NEXT_PUBLIC_API_BASE=https://api.flixworld.xyz/api
#
# Option B: Backend on same domain, different port (only if port is publicly open)
#NEXT_PUBLIC_API_BASE=https://your-vps-ip:8000/api
#
# Option C: Backend proxied through the same domain (e.g. nginx /api/ → :8000)
#NEXT_PUBLIC_API_BASE=https://flixworld.xyz/api
#
# Local development only:
NEXT_PUBLIC_API_BASE=https://api.flixworld.xyz/api

# ── Stream proxy token secret ────────────────────────────────────────────────
# Server-only (no NEXT_PUBLIC_ prefix) — never sent to the browser.
# Used to sign short-lived tokens that gate the /api/stream/* proxy routes.
# Generate a strong random value: openssl rand -hex 32
STREAM_PROXY_SECRET=

# ── API Access Tokens ─────────────────────────────────────────────────────────
# API_SECRET_KEY: server-side only (no NEXT_PUBLIC_). Used by Next.js SSR/API routes.
#   Must match API_SECRET_KEY in backend/.env
API_SECRET_KEY=

# NEXT_PUBLIC_API_CLIENT_KEY: browser-safe. Used by client-side React hooks.
#   Must match API_CLIENT_KEY in backend/.env
NEXT_PUBLIC_API_CLIENT_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get your Client ID from https://console.cloud.google.com/
# Same value must be set as GOOGLE_CLIENT_ID in backend/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

CACHE_HOMEPAGE_TTL=0
CACHE_MOVIE_DETAIL_TTL=3600
CACHE_TV_DETAIL_TTL=3600
CACHE_MOST_WATCHED_TTL=600

# ── Browser / CDN HTTP Cache-Control headers ──────────────────────────────────
CACHE_SUBTITLE_MAX_AGE=86400
CACHE_HLS_SEGMENT_MAX_AGE=86400
